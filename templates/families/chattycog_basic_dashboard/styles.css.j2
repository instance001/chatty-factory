:root {
  --bg: #eef4f1;
  --panel: #ffffff;
  --ink: #153336;
  --muted: #567378;
  --accent: #1f8a70;
  --line: #cce0db;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: "Segoe UI", sans-serif;
  background:
    linear-gradient(180deg, rgba(31, 138, 112, 0.08), transparent 24%),
    var(--bg);
  color: var(--ink);
}

.module-shell {
  width: min(1040px, calc(100% - 2rem));
  margin: 0 auto;
  padding: 2rem 0 3rem;
}

.module-hero,
.module-panel {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  box-shadow: 0 14px 36px rgba(21, 51, 54, 0.06);
}

.module-hero,
.module-panel {
  padding: 1.25rem;
  margin-bottom: 1rem;
}

.module-kicker {
  margin: 0 0 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--accent);
  font-size: 0.78rem;
}

.module-grid {
  display: grid;
  gap: 1rem;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
}
