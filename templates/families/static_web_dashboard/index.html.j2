<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body data-family="static_web_dashboard">
  <main class="dashboard-shell">
    <header class="hero">
      <p class="eyebrow">ChattyFactory Dashboard</p>
      <h1>{{ title }}</h1>
      <p class="summary">{{ summary }}</p>
    </header>

    <section class="operator-grid" aria-label="Dashboard metrics">
      <article class="metric-card">
        <h2>Ready State</h2>
        <p id="primary-metric">{{ primary_metric_label }}</p>
      </article>
      <article class="metric-card">
        <h2>Route</h2>
        <p id="route-metric">{{ route_label }}</p>
      </article>
    </section>

    <section class="panel-row">
      <section class="panel status-panel">
        <h2>Status</h2>
        <p id="status-text">{{ status_text }}</p>
      </section>
      <section class="panel action-toolbar">
        <h2>Actions</h2>
        <div class="toolbar-actions">
          <button id="primary-action" type="button">{{ primary_action_label }}</button>
          <button id="secondary-action" type="button">{{ secondary_action_label }}</button>
        </div>
      </section>
    </section>

    {% if helper_monitoring %}
    <section class="panel-row helper-monitoring-row">
      <section class="panel helper-monitor-panel" data-helper-surface="summary">
        <h2>Helper Monitoring</h2>
        <p id="helper-summary-status">Loading helper summary...</p>
        <p id="helper-summary-count">Checking processed helper files...</p>
        <p id="helper-summary-lanes">Checking observed inbox lanes...</p>
      </section>
      <section class="panel helper-preview-panel" data-helper-surface="preview">
        <h2>Processed Preview</h2>
        <p id="helper-preview-status">Loading processed helper preview...</p>
        <pre id="helper-preview-body" class="helper-preview-body">Waiting for helper output.</pre>
      </section>
    </section>
    {% endif %}

    <section class="panel results-panel">
      <h2>{{ results_heading }}</h2>
      <div id="results-root">{{ results_empty }}</div>
    </section>
  </main>

  <script src="app.js"></script>
</body>
</html>
