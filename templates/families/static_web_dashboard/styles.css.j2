:root {
  color-scheme: light;
  --bg: #f3efe4;
  --panel: #fffdf8;
  --ink: #1f2a2c;
  --muted: #5c696c;
  --accent: #c65d2e;
  --line: #d9cfbf;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: "Segoe UI", sans-serif;
  background:
    radial-gradient(circle at top right, rgba(198, 93, 46, 0.12), transparent 28%),
    linear-gradient(180deg, #f8f3ea 0%, var(--bg) 100%);
  color: var(--ink);
}

.dashboard-shell {
  width: min(1080px, calc(100% - 2rem));
  margin: 0 auto;
  padding: 2rem 0 3rem;
}

.hero,
.panel,
.metric-card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 18px;
  box-shadow: 0 16px 40px rgba(31, 42, 44, 0.06);
}

.hero {
  padding: 1.5rem;
  margin-bottom: 1rem;
}

.eyebrow {
  margin: 0 0 0.5rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--accent);
  font-size: 0.78rem;
}

.summary {
  color: var(--muted);
}

.operator-grid,
.panel-row {
  display: grid;
  gap: 1rem;
  margin-bottom: 1rem;
}

.operator-grid {
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

.panel-row {
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
}

.metric-card,
.panel {
  padding: 1.25rem;
}

.helper-monitor-panel,
.helper-preview-panel {
  border-color: rgba(53, 92, 125, 0.24);
  background: linear-gradient(180deg, rgba(53, 92, 125, 0.05), rgba(198, 93, 46, 0.04));
}

.helper-preview-body {
  margin: 0.8rem 0 0;
  padding: 0.9rem;
  border-radius: 12px;
  background: rgba(31, 42, 44, 0.07);
  color: #233033;
  white-space: pre-wrap;
  word-break: break-word;
}

.toolbar-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

button {
  border: 0;
  border-radius: 999px;
  padding: 0.8rem 1rem;
  background: var(--accent);
  color: white;
  cursor: pointer;
}

button:last-child {
  background: #355c7d;
}

@media (max-width: 640px) {
  .dashboard-shell {
    width: min(100% - 1rem, 100%);
    padding-top: 1rem;
  }
}
